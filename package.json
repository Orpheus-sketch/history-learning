{
  "name": "history-learning",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"var f=require('fs');var p='dist/index.html';var h=f.readFileSync(p,'utf8');h=h.replace('BUILD_TAG',Date.now());f.writeFileSync(p,h)\"",
    "preview": "vite preview --host 0.0.0.0",
    "start": "npm run build && npm run preview",
    "share": "npm run build && concurrently \"npm run preview\" \"node scripts/tunnel.mjs\""
  },
  "dependencies": {
    "concurrently": "^10.0.0",
    "json-server": "^0.17.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "localtunnel": "^2.0.2",
    "vite": "^8.0.12"
  }
}
